# Cognito User Pool OIDC configuration.
# Copy this file to .env.local and fill in real values for your environment.

# Cognito Hosted UI issuer, e.g. https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
VITE_COGNITO_AUTHORITY=

# App client ID configured on the Cognito User Pool's app client
VITE_COGNITO_CLIENT_ID=

# Must be registered as an allowed callback URL on the Cognito app client
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback

# Must be registered as an allowed sign-out URL on the Cognito app client
VITE_COGNITO_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login

# Dedicated silent-renew redirect URI (separate from the callback route);
# must also be registered as an allowed callback URL on the Cognito app client
VITE_COGNITO_SILENT_REDIRECT_URI=http://localhost:5173/silent-renew
